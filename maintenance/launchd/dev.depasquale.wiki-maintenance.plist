<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.depasquale.wiki-maintenance</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/projects/vault-engine/maintenance/wiki-maintenance.sh</string>
    </array>

    <!-- Weekly: Sunday 03:00. LaunchAgents don't wake the Mac so missed
         calendar triggers fire on next wake. Combined with RunAtLoad to
         cover boot/login. Script is idempotent: re-running just regenerates
         proposals against current vault_sha. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/wiki-maintenance.launchd.stdout</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/wiki-maintenance.launchd.stderr</string>
</dict>
</plist>
